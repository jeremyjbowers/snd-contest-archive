CATALOG_URL=csv:data/entries.csv

# Membership gate. Unset: on for snd.org and its subdomains, off on every other
# host, because the MembershipWorks cookie is only sent to *.snd.org.
# MEMBER_GATE=on
# MEMBER_GATE=off
# MEMBERSHIPWORKS_ORG=17787
# CATALOG_URL=postgres://snd:snd@localhost:5432/snd
# App Platform injects the managed Postgres URL, including sslmode=require.
